# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies（包管理器为 pnpm，npm/yarn lockfile 属误生成）
/node_modules
/package-lock.json
/yarn.lock
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# PDF.js 静态资源由构建脚本按依赖版本同步
/public/pdfjs/
